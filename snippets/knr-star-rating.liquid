{% doc %}
  Displays a rating out of 5 using filled and empty stars.

  @param {number} rating - Rating from 0 to 5
{% enddoc %}

{%- assign value = rating.rating | default: rating -%}
{%- assign filled = value | round -%}

<span class="knr-star-rating" role="img" aria-label="{{ value }} / 5">
  {%- for i in (1..5) -%}
    {%- if i <= filled -%}
      ★
    {%- else -%}
      ☆
    {%- endif -%}
  {%- endfor -%}
</span>