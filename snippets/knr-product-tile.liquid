{% doc %}
  Product tile: image, quick add button, name and price.

  @param {product} product - The product to display
  @param {string} add_label - Aria-label for the quick add button
{% enddoc %}
<script src="{{ 'knr-quick-add.js' | asset_url }}" defer></script>

{%- assign variant = product.selected_or_first_available_variant -%}

<div class="knr-product-tile">
  <div class="knr-product-tile__media">
    <a href="{{ product.url }}" tabindex="-1" aria-hidden="true">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 480 | image_tag: widths: '160, 320, 480', sizes: '160px', alt: '', loading: 'lazy', class: 'knr-product-tile__image' }}
      {%- endif -%}
    </a>
    <knr-quick-add>
      {%- form 'product', product, class: 'knr-product-tile__form' -%}
        <input type="hidden" name="id" value="{{ variant.id }}">
        <button
          type="submit"
          class="knr-product-tile__add"
          aria-label="{{ add_label }}"{% unless variant.available %} disabled{% endunless %}
        >
          {% render 'knr-icon', variant: 'cross' %}
        </button>
      {%- endform -%}
    </knr-quick-add>
  </div>

  <div class="knr-product-tile__info">
    <a class="knr-product-tile__title" href="{{ product.url }}">{{ product.title }}</a>
    <span class="knr-product-tile__price">{{ product.price | money }}</span>
  </div>
</div>